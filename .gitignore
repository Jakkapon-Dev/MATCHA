.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
backend/.env.local
backend/.env.production
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.production
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 5. Logs & Runtime Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.log.*

