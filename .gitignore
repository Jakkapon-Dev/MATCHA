# ==============================================================================
# MatchA — Master .gitignore Configuration
# Continuously updated for clean repository and deployment security
# ==============================================================================

# 1. CI/CD & GitHub Workflows (Explicitly disabled/ignored)
.github/
.github/*
.github-actions/
*.runner.log

# 2. Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
package-lock.json.bak
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# 3. Production Build & Output
dist/
dist-ssr/
build/
out/
*.local
*.tsbuildinfo

# 4. Deployment Artifacts & Cloud Caches
.vercel/
.vercel
.turbo/
.next/
.nuxt/
.output/
.netlify/
.serverless/

# 5. Environment Variables & Secret Credentials (NEVER COMMIT)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
backend/.env.local
backend/.env.production
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.production
app/backend/.env
app/backend/.env.*
app/frontend/.env
app/frontend/.env.*
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 6. Logs & Runtime Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*.log.*

# 7. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
*.bak
*.backup
*.orig

# 8. AI Agent Caches, Knowledge Graphs & Index Directories
.agents/
.agents/*
.claude/
.claude/*
.gemini/
.gemini/*
.cursor/
.windsurf/
graft/
graft/*

# 9. Vite, Bundler & Local Cache Stores
.vite/
.cache/
*.tmp
*.temp
*.cache
.eslintcache
.stylelintcache

# 10. Test Results & Coverage Dumps
coverage/
*.lcov
test-output/
playwright-report/
blob-report/
.nyc_output/
*.dump
*.dmp
*.stackdump

# 11. Temporary Local Data & Generated Exports (Spreadsheets / Dumps)
*.export.csv
*.export.json
MatchA_*_Backup_*.json
MatchA_*_Report_*.csv
MatchA_Inventory_*.csv
MatchA_Orders_*.csv
MatchA_Revenue_*.csv
MatchA_VIP_*.csv
MatchA_Full_Store_Backup_*.json

# 12. Personal & Internal Interview Notes (Do not upload to Git)
interview.md
*interview*.md
*scratch*.js
*scratch*.ts
scripts/scratch/
app/scripts/scratch/
