# Server Port (Render will automatically override with dynamic PORT)
PORT=5001

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hak50ja.mongodb.net/MatchA?appName=Cluster0

# Isolated Test Database URI (Required for E2E tests and test restore scripts)
TEST_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hak50ja.mongodb.net/MatchA_test?appName=Cluster0

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Origin URL (used for CORS / server info)
FRONTEND_URL=http://localhost:5173

# Firebase Web API key used by the server to validate Firebase ID tokens.
FIREBASE_WEB_API_KEY=

# Admin Initial Seed Credentials
ADMIN_SEED_PASSWORD=your_admin_seed_password

# --- Email (Resend) ---
# Add both values to the Render service Environment page to enable real order
# confirmations and password-reset emails. Keep RESEND_API_KEY backend-only.
# EMAIL_FROM must be an address on a domain verified with Resend. On the free
# tier, an unverified sender can deliver only to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=

# --- Image storage (optional) ---
# Uploaded images are written to backend/storage/media by default. That disk is
# ephemeral on Render's free tier: every deploy wipes it while MongoDB keeps the
# URLs, so admin uploads become broken images. Set CLOUDINARY_URL and uploads go
# to Cloudinary instead; leave it blank and nothing changes. Existing images
# already on disk keep being served either way, so this can be switched on at
# any time without a migration.
# Copy the value verbatim from the Cloudinary dashboard (API Environment
# variable). It contains the API secret — backend only, never a VITE_ var.
CLOUDINARY_URL=

# --- Stripe payments (test mode) ---
# Keep both values on the backend only. Obtain test keys from the Stripe
# dashboard and a webhook signing secret from Stripe CLI/dashboard.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
