# Server Port (Render will automatically override with dynamic PORT)
PORT=5001

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hak50ja.mongodb.net/MatchA?appName=Cluster0

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Origin URL (used for CORS / server info)
FRONTEND_URL=http://localhost:5173

# Firebase Web API key used by the server to validate Firebase ID tokens.
FIREBASE_WEB_API_KEY=

# Admin Initial Seed Credentials
ADMIN_SEED_PASSWORD=your_admin_seed_password

# --- Email (optional) ---
# Order confirmations are sent through Resend. Leave both blank and the shop
# still works: nothing is sent, a single warning is logged, and orders are
# unaffected.
# EMAIL_FROM must be an address on a domain verified with the provider —
# the free tier will only deliver to your own address until you verify one.
RESEND_API_KEY=
EMAIL_FROM=
