# Copy to frontend/.env only when you need it. Local development does not:
# Vite's proxy already forwards /api to the backend on port 5001.

# Full origin of the deployed API, with no trailing slash and no /api on the end.
# Set this on the host when the frontend and the backend live at different
# addresses, which is the normal case once deployed.
#
#   VITE_API_URL=https://matcha-api.onrender.com
#
# Leaving it empty keeps requests on /api, which is what you want locally.
VITE_API_URL=
