# Copy to frontend/.env only when you need it. Local development does not:
# Vite's proxy already forwards /api to the backend on port 5001.

# Full origin of the deployed API, with no trailing slash and no /api on the end.
# Set this on the host (e.g. Vercel Environment Variables) when deployed:
#
#   VITE_API_URL=https://matcha-gluk.onrender.com
#
# Leaving it empty keeps requests on /api proxy, which is what you want locally.
VITE_API_URL=
